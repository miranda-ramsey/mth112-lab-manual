<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-double-angle" xmlns:xi="http://www.w3.org/2001/XInclude">

    <title>Double Angle Identities</title>
    <introduction>
        <p>
            In this section, we will learn to use double-angle and half-angle formulas to find 
            exact trigonometric values and verify identities, and use reduction identities to
            simplify an expression.
        </p>
    </introduction>

    <subsection>
        <title>Textbook Reference</title>
        <p> 
            This relates to content in <section-mark/>9.3 of
            <url href="https://openstax.org/details/books/algebra-and-trigonometry-2e" visual="http://tiny.cc/111Z-Textbook">Algebra and Trigonometry 2e</url>.
        </p>
    </subsection>

    <exercises xml:id="prep-double-angle">
		<title>Preparation Exercises</title>
            <introduction>
                <p>
                    Answer the following without using a calculator. These questions are intended 
                    to check the prerequisite skills needed to complete the rest of the lab.
                </p>
            </introduction>
		<exercise>
            <statement>
                <p>
                    Use the sum of angles for sine formula, 
                    <m>\sin(\alpha +\beta) = \sin(\alpha)\cos(\beta)+\cos(\alpha)\sin(\beta)</m>, to 
                    evaluate and simplify the expression <m>\sin(\theta + \theta)</m>
                </p>
            </statement>
		</exercise>
		<exercise>
            <introduction>
                <p>
                    In which quadrants are the function values negative?
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>\sin(\theta)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\cos(\theta)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\tan(\theta)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\sec(\theta)</m>
                    </p>
                </statement>
            </task>
        </exercise>
		<exercise>
            <statement>
                <p>
                    True or false:
                    <md>\sin(60^\circ + 60^\circ) = 2\sin(60^\circ)</md>
                    Explain your reasoning.
                </p>
            </statement>
		</exercise>
		<exercise>
            <statement>
                <p>
                    Verify the identity algebraically:
                    <md>\frac{\cos(\tau)}{1 + \sin(\tau)} = \sec(\tau)-\tan(\tau)</md>
                </p>
            </statement>
		</exercise>
	</exercises>


	<exercises xml:id="practice-double-angle">
		<title>Practice Exercises</title>
		<exercise>
            <introduction>
                <p>
                    Find the values using the half angle identities.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>\sin(22.5^\circ)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\cos(15^\circ)</m>
                    </p>
                </statement>
            </task>
		</exercise>
		<exercise>
            <introduction>
                <p>
                    If <m>\sin(\phi) = \frac{1}{6}</m> and <m>\phi</m> is in quadrant II, find the 
                    following values:
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>\cos(\phi)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\tan(\phi)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\sin(2\phi)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\cos(2\phi)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\tan(2\phi)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\sin(\frac{\phi}{2})</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\cos(\frac{\phi}{2})</m>
                    </p>
                </statement>
            </task>
		</exercise>
		<exercise>
            <introduction>
                <p>
                    Verify the identities algebraically.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>\sec^2(\theta)=\frac{2}{1 + \cos(2\theta)}</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\left(2\sin(\theta) - 3\cos(\theta)\right)^2\sec^2(\theta)=4 - 6\sin(2\theta) + 5\cos^2(\theta)</m>
                    </p>
                </statement>
            </task>
		</exercise>
        <exercise>
            <statement>
                <p>
                    Using a graphing utility, find the value of <m>C</m> that makes the equation an identity:
                    <md> \left(\cos(x) + \sec(x)\right)^2 = C + \tan^2(x) - \sin^2(x)</md>
                </p>
            </statement>
        </exercise>
    </exercises>

    
    <subsection xml:id="definitions-double-angle">
        <title>Definitions</title>
        <definition>
            <title>Double-Angle Identities</title>
            <statement>
                <p>
                    Each of the trigonometric functions has a formula that accounts for an angle 
                    that is twice as large as some starting angle, the <term>double-angle identities.</term> 
                    We will focus only on those for sine, cosine, and tangent. The formulas are summarized below.
                    <md>
                        \sin(2\theta)=2\sin(\theta)\cos(\theta)
                    </md>
                    <md>
                        <mrow>\cos(2\theta)\amp=\cos^2(\theta)-\sin^2(\theta)</mrow>
                        <mrow>\amp=1-2\sin^2(\theta)</mrow>
                        <mrow>\amp=2\cos^2(\theta)-1</mrow>
                    </md>
                    <md>
                        \tan(2\theta) = \dfrac{2\tan(\theta)}{1-\tan^2(\theta)}
                    </md>
                </p>
            </statement>
        </definition>
        <definition>
            <title>Half-Angle Identities</title>
            <statement>
                <p>
                    <md>
                        \sin\left(\frac{\theta}{2}\right)=\pm\sqrt{\dfrac{1-\cos(\theta)}{2}}
                    </md>
                    <md>
                        \cos\left(\frac{\theta}{2}\right)=\pm\sqrt{\dfrac{1+\cos(\theta)}{2}}
                    </md>
                    <md>
                        \tan\left(\frac{\theta}{2}\right)=\pm\sqrt{\dfrac{1-\cos(\theta)}{1+\cos(\theta)}}
                    </md>
                </p>
            </statement>
        </definition>
	</subsection>
        
    <exercises xml:id="exit-double-angle">
        <title>Exit Exercises</title>
        <exercise>
            <introduction>
                <p>
                If <m>\tan(\rho)=\frac{4}{3}</m> and <m>\rho</m> is in quadrant III, find the following values.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>\cos(\rho)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\sin(2\rho)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\sin(\dfrac{\rho}{2}</m>
                    </p>
                </statement>
            </task>
	    </exercise>
        <exercise>
		    <statement>
                <p>
                    Algebraically verify the identity 
                    <md>\sin(4\alpha) = 8 \sin(\alpha)\cos^3(\alpha) - 4\sin(\alpha)\cos(\alpha)</md>
                </p>
            </statement>
	    </exercise>
    </exercises>

    <reading-questions>
        <exercise>
            <statement>
                <p>On a scale of 1-5, how are you feeling with the concepts related to the graphical behaviors of functions?</p>
            </statement>
        </exercise>
    </reading-questions>
