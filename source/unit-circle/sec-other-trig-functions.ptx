    <subsection xml:id="definitions-other-trig-functions">
        <title>Definitions</title>
        <definition>
            <title>The "Other" Trigonometric Functions</title>
            <statement>
                <p>
                    <md>
                        <mrow></mrow>
                        <mrow></mrow>
                        <mrow></mrow>
                        <mrow></mrow>
                    </md>
                </p>
