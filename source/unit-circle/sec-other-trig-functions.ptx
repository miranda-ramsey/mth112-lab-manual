                            <![CDATA[
                            \begin{tikzpicture}[
                                declare function={
                                func(\x)= (\x<=-4) * (2/3*(\x+4)^2+1)  +
                                and(\x>-4, \x<=-3)   +
                                and(\x>-3, \x<=-2) * ((x+3)^2+1)   +
                                and(\x>-2, \x<=0) * (-(x+1)^2+3)   +
                                and(\x>0, \x<=2) * (-2*x+2)    +
                                and(\x>2, \x<=4) * ((x-3)^2-3) +
                                (\x>4) * (2*(x-4)-2);
                                }
                                ]
                                \begin{axis}[xlabel={$t$}]
                                \addplot+[domain=-7:6, samples=66, closedopen] {func(x)};
                                \legend{\(y = r(t)\)}
                                \end{axis}
                            \end{tikzpicture}
