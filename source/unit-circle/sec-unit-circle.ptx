            <exercise>
                <statement>
                    <p>
                        Which angle, <m>\theta</m>, between <m>0</m> and <m>2\pi</m> has a sine value of
                        <m>-\frac{\sqrt{3}}{2}</m> and a cosine value of <m>\frac{1}{2}</m>?
                    </p>
                </statement>
            </exercise>
            <exercise>
                <statement>
