    <subsection xml:id="definitions-right-angle-trig">
        <title>Definitions</title>

        <introduction>
            <p>
                Consider the triangle shown in <xref ref="figure-right-triangle-definitions"/>.
            </p>
            <figure xml:id="figure-right-triangle-definitions">
                <caption>A right trangle</caption>
                <image width="60%">
                    <description>
                        <p>
                            <!--TODO-->
                        </p>
                    </description>
                    <latex-image>
                        <![CDATA[
                            \begin{tikzpicture}
                            \coordinate (O) at (0,0);
                            \coordinate (A) at (5,0);
                            \coordinate (B) at (5,3);
                            \draw (O)--(A)--(B)--cycle;
                            \footnotesize
                            \tkzLabelSegment[below=2pt](O,A){Adjacent}
                            \tkzLabelSegment[above=2pt,rotate=atan(3/5)](O,B){Hypotenuse}
                            \tkzLabelSegment[above=2pt,rotate=-90](A,B){Opposite}

                            \tkzMarkRightAngle[size=0.5](O,A,B)
                            \tkzMarkAngle[size=0.9cm](A,O,B)
                            \tkzLabelAngle[pos = 0.7](A,O,B){$\theta$}
                            \end{tikzpicture}
                        ]]>
                    </latex-image>
                </image>
            </figure>
        </introduction>

        <definition>
            <title>SOHCAHTOA</title>
            <statement>
                <p>
                    <term>SOHCAHTOA</term> stands for
                    <ul>
                        <li>
                            <p>
                                <em>S</em>ine is <em>O</em>pposite over <em>H</em>ypotenuse.
                            </p>
                        </li>
                        <li>
                            <p>
                                <em>C</em>osine is <em>A</em>djacent over <em>H</em>ypotenuse.
                            </p>
                        </li>
                        <li>
                            <p>
                                <em>T</em>angent is <em>O</em>pposite over <em>A</em>djacent.
                            </p>
                        </li>
                    </ul>
                    These mean the following:
                    <md>
                        <mrow>\sin(\theta)=\frac{\text{Opposite}}{\text{Hypotenuse}}</mrow>
                        <mrow>\cos(\theta)=\frac{\text{Adjacent}}{\text{Hypotenuse}}</mrow>
                        <mrow>\tan(\theta)=\frac{\text{Opposite}}{\text{Adjacent}}</mrow>
                    </md>
                </p>
            </statement>
        </definition>

        <definition>
            <title>CHOSHACAO</title>
            <statement>
                <p>
                    <term>CHOSHACAO</term> stands for
                    <ul>
                        <li>
                            <p>
                                <em>C</em>osecant is <em>H</em>ypotenuse over <em>O</em>pposite.
                            </p>
                        </li>
                        <li>
                            <p>
                                <em>S</em>ecant is <em>H</em>ypotenuse over <em>A</em>djacent.
                            </p>
                        </li>
                        <li>
                            <p>
                                <em>C</em>otangent is <em>A</em>djacent over <em>O</em>pposite.
                            </p>
                        </li>
                    </ul>
                    These mean the following:
                    <md>
                        <mrow>\csc(\theta)=\frac{\text{Hypotenuse}}{\text{Opposite}}</mrow>
                        <mrow>\sec(\theta)=\frac{\text{Hypotenuse}}{\text{Adjacent}}</mrow>
                        <mrow>\cot(\theta)=\frac{\text{Adjacent}}{\text{Opposite}}</mrow>
                    </md>
                </p>
            </statement>
        </definition>

    </subsection>

    <exercises xml:id="exit-right-trig">
        <title>Exit Exercises</title>
