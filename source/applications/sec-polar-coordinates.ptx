    <subsection xml:id="definitions-polar-coordinates">
        <title>Definitions</title>
        <definition>
            <title>Polar Function</title>
            <statement>
                <p>
                    A <term>polar function</term> is usually given in the form <m>\rho = f(\theta)</m>
                    where <m>\theta</m> is the angle measured from the standard position along the
                    positive <m>x</m>-axis, and <m>\rho</m> is the radius measured from the origin.
                </p>
            </statement>
        </definition>
        <definition>
            <title>Conversion formulas</title>
            <statement>
                <p>
                    <ul>
                        <li></li>
                        <li></li>
                        <li></li>
                    </ul>
                </p>
            </statement>
        </definition>
	</subsection>
        
