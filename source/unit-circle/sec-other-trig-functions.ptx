        <exercise>
            <introduction>
                <p>
                </p>
                <figure xml:id="graph-domain-range-exit">
                    <caption><m>y=F(x)</m></caption>
                    <image width="60%">
                        <description>
                            <p>
                                Graph of a function. From below, the curve travels up to the point <m>(-7,2)</m>,
                                then passes smoothly through the points <m>(-4,-1)</m>;
                                <m>(-2,-1)</m>;
                                <m>(0,-3)</m>;
                                <m>(5,4)</m>;
                                <m>(7,0)</m>;
                                then continues downward and to the right off of the grid.
                            </p>
                        </description>
                        <latex-image>
                            <![CDATA[
                            \begin{tikzpicture}[
                                declare function={
                                func(\x)=
                                (\x<=-7) * (-2*(\x+7)^2+2)  +
                                and(\x>-7, \x<=-5) * (-0.5*(\x+7)^2+2)  +
                                and(\x>-5, \x<=-4) * ((\x+4)^2-1)   +
                                and(\x>-4, \x<=-2) * (-1)   +
                                and(\x>-2, \x<=-1) * (-1*(\x+2)^2-1)    +
                                and(\x>-1, \x<=1) * ((\x)^2-3)  +
                                and(\x>1, \x<=3) * (2*(\x-1)-2) +
                                and(\x>3, \x<=5) * (-0.5*(\x-5)^2+4)    +
                                and(\x>5, \x<=7) * (-1*(\x-5)^2+4)  +
                                (\x>7) * (4/(\x-6)-4);
                                }
                                ]
                                \begin{axis}[
                                width=\axisdefaultwidth,
                                height=0.6*\axisdefaultheight,
                                xmin=-10,xmax=10,
                                ymin=-5,ymax=5,
                                xtick={-8,-6,...,8},
                                minor xtick={-9,-7,-5,...,7,9},
                                ytick={-4,-2,...,6},
                                minor ytick={-7,-5,...,7},
                                ]
                                \addplot+[samples=100, domain=-8.871:10] {func(x)};
                                \end{axis}
                                \end{tikzpicture}
                                ]]>
                        </latex-image>
                    </image>
                </figure>
            </introduction>
