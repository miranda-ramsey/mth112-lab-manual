    <exercises xml:id="exit-right-trig">
        <title>Exit Exercises</title>
        <exercise>
            <introduction>
                <p>
                    Use the triangle in <xref provisional="Figure 5.12"/> to answer the questions 
                    below.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        Find the value of <m>\cos(\theta)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        Find the value of <m>\tan(\theta)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        Find the value of <m>\csc(\theta)</m>
                    </p>
                </statement>
            </task>
        </exercise>
        <exercise>
			<statement>
                <p>
                    Shown in <xref provisional="Figure 5.13"/> is a triangle with side <m>b=11</m>, 
                    angle <m>B = 22^/circ</m>, and angle <m>C = 90^\circ</m>. Find the length of 
                    the side <m>a</m>.
                </p>
			</statement>
        </exercise>
    </exercises>
    <reading-questions>
        <exercise>
            <statement>
                <p>On a scale of 1-5, how are you feeling with the concepts related to the graphical behaviors of functions?</p>
            </statement>
        </exercise>
    </reading-questions>

</section>
