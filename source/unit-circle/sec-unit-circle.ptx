<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-unit-circle" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>The Unit Circle</title>
    <introduction>
        <p>
            In this section, we will find function values for the sine and cosine of 30<degree/>,
            45 <degree/>, and 60<degree/>, identify the domain and range of sine and cosine 
            functions, find reference angles, and use reference angles to evaluate trigonometric
            functions.
        </p>
    </introduction>

    <subsection>
        <title>Textbook Reference</title>
        <p> 
            This relates to content in <section-mark/>7.3 of 
            <url href="https://openstax.org/details/books/algebra-and-trigonometry-2e" visual="http://tiny.cc/111Z-Textbook">Algebra and Trigonometry 2e</url>.
        </p>
    </subsection>

	<exercises xml:id="prep-unit-circle">
		<title>Preparation Exercises</title>
	    <introduction>
			<p>
                Answer the following without using a calculator. These questions are intended 
                to check the prerequisite skills needed to complete the rest of the lab.
			</p> 
		</introduction> 
		<exercise>
		    <statement> 
				<p>
                    For a right triangle with side <m>\alpha = \frac{1}{2}</m> and hypotenuse
                    <m>c=1</m>, find the missing side <m>b</m> using the Pythagorean Theorem.
				</p>
			</statement> 
        </exercise>
        <exercise>
            <introduction>
                <p>
                    Which quadrant are the following angles in?
                </p>
            </introduction>
            <task>
				<statement>
					<p>
                        <m>\frac{3\pi}{4}</m>
					</p>
				</statement>
            </task>
            <task>
				<statement>
					<p>
                        <m>\frac{4\pi}{3}</m>
					</p>
				</statement>
            </task>
            <task>
				<statement>
					<p>
                        <m>\frac{11\pi}{6}</m>
					</p>
				</statement>
            </task>
            <task>
				<statement>
					<p>
                        <m>\frac{\pi}{3}</m>
					</p>
				</statement>
            </task>
            <task>
				<statement>
					<p>
                        <m>\frac{-\pi}{6}</m>
					</p>
				</statement>
            </task>
            <task>
				<statement>
					<p>
                        <m>\frac{-2\pi}{3}</m>
					</p>
				</statement>
            </task>
            <task>
				<statement>
					<p>
                        <m>\frac{-7\pi}{6}</m>
					</p>
				</statement>
            </task>
            <task>
				<statement>
					<p>
                        <m>\frac{5\pi}{6}</m>
					</p>
				</statement>
            </task>
		</exercise>

		<exercise>
			<statement>
				<p>
                    Simplify <m>2\pi - \frac{2\pi}{3}</m> without a calculator.
				</p>
			</statement>
		</exercise>

		<exercise>
			<statement>
				<p>
                    Count from <m>0</m> to <m>2\pi</m> by multiples of <m>\frac{\pi}{12}</m>, then
                    reduce those fractions. Here's how to start out: 
                    <m>\frac{0\pi}{12}, \frac{\pi}{12}, \frac{2\pi}{12}, \frac{3\pi}{12},...</m>
				</p>
			</statement>
		</exercise>
	</exercises>

	<exercises xml:id="practice-unit-circle">
		<title>Practice Exercises</title>
		<exercise>
            <task>
                <statement>
                    <p>
                        If <m>\cos(\theta)=\frac{1}{5}</m> and <m>\sin(\theta) = -\frac{2\sqrt{5}}{5}</m>,
                        which quadrant must <m>\theta</m> be in?
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        If <m>\cos(\phi)=-\frac{2}{3}</m> and <m>\sin(\phi) = \frac{\sqrt{5}}{3}</m>,
                        which quadrant must <m>\phi</m> be in?
                    </p>
                </statement>
            </task>
        </exercise>
		<exercise>
			<introduction>
				<p>
                    Find the reference angles for the given angles.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        340<degree/>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        440<degree/>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\frac{8\pi}{3}</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\frac{9\pi}{7}</m>
                    </p>
                </statement>
            </task>
        </exercise>
		<exercise>
			<introduction>
				<p>
                    Which of the standard angles between <m>0</m> and <m>2\pi</m> on the unit circle
                    do the following <m>x</m> and <m>y</m> coordinates go with?
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>\left(\frac{1}{2},\frac{\sqrt{3}}{2}\right)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\left(\frac{-\sqrt{2}}{2},\frac{\sqrt{2}}{2}\right)</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\left(\frac{\sqrt{3}}{2},-\frac{1}{2}\right)</m>
                    </p>
                </statement>
            </task>
        </exercise>
		<exercise>
            <task>
                <statement>
                    <p>
                        If <m>\cos(\theta)=\frac{1}{5}</m> and <m>0 \leq \theta \leq \frac{\pi}{2}</m>,
                        find the value of <m>\sin(\theta)</m>.
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        If <m>\sin(\alpha)=-\frac{3}{7}</m> and <m>\pi \leq \alpha\leq \frac{3\pi}{2}</m>,
                        find the value of <m>\cos(\alpha)</m>.
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        If <m>\cos(\beta)=-\frac{3}{4}</m> and <m>\frac{\pi}{2} \leq \beta \leq \pi</m>,
                        find the value of <m>\sin(\beta)</m>.
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\cos(\frac{15\pi}{6})</m>
                    </p>
                </statement>
            </task>
        </exercise>
		<exercise>
			<introduction>
				<p>
                    Evaluate the expressions without a calculator by first finding and using the 
                    reference angles for the angles shown.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        <m>\sin(\frac{3\pi}{2})</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\sin(\frac{7\pi}{3})</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\cos(\frac{11\pi}{4})</m>
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        <m>\cos(\frac{15\pi}{6})</m>
                    </p>
                </statement>
            </task>
        </exercise>
    </exercises>

    
    <subsection xml:id="def-unit-circle">
        <title>Definitions</title>
        <definition>
            <title>The Unit Circle</title>
            <statement>
                <p>
                    A <term>unit circle</term> is a circle with radius 1.
                </p>
            </statement>
        </definition>
        <definition>
            <title>Cosine of an Angle</title>
            <statement>
                <p>
                    The <term>cosine of an angle</term>, <m>\theta</m>, is equal to the 
                    <m>x</m>-value at that angle on a unit circle.
                </p>
            </statement>
        </definition>
        <definition>
            <title>Sine of an Angle</title>
            <statement>
                <p>
                    The <term>sine of an angle</term>, <m>\theta</m>, is equal to the <m>y</m>-value
                    at that angle on a unit circle.
                </p>
            </statement>
        </definition>
        <definition>
            <title>The Pythagorean Identity</title>
            <statement>
                <p>
                    The <term>Pythagorean Identity</term> is the relationship between sine and cosine
                    values, <m>\sin^2(\theta) + \cos^2(\theta) = 1</m>, relating to the Pythagorean 
                    Theorem in <xref provisional="Figure 5.14"/>.
                </p>
            </statement>
        </definition>
        <definition>
            <title>Reference Angle</title>
            <statement>
                <p>
                    A <term>reference angle</term>, <m>\alpha</m>, to an angle <m>\theta</m>, is the 
                    acute (or right) positive angle between the <m>x</m>-axis to the angle <m>\theta</m>
                    as shown in <xref provisional="Figure 5.15"/>.
                </p>
            </statement>
        </definition>
	</subsection>
        
    <exercises xml:id="exit-unit-circle">
        <title>Exit Exercises</title>
        <exercise>
            <statement>
                <p>
                    Which angle, <m>\theta</m>, between <m>0</m> and <m>2\pi</m> has a sine value of
                    <m>-\frac{\sqrt{3}}{2}</m> and a cosine value of <m>\frac{1}{2}</m>?
                </p>
            </statement>
        </exercise>
        <exercise>
            <statement>
                <p>
                    What is the reference angle for <m>\frac{7\pi}{6}</m>?
                </p>
            </statement>
        </exercise>
        <exercise>
            <statement>
                <p>
                    Evaluate <m>\sin(\frac{11\pi}{3})</m> without a calculator.
                </p>
            </statement>
        </exercise>
        <exercise>
            <statement>
                <p>
                    If <m>\sin(\theta)=-\frac{1}{4}</m> and <m>\pi \leq \theta \leq \frac{3\pi}{2}</m>,
                    find the value of <m>\cos(\theta)</m>.
                </p>
            </statement>
        </exercise>
    </exercises>

    <reading-questions>
        <exercise>
            <statement>
                <p>On a scale of 1-5, how are you feeling with the concepts related to the graphical behaviors of functions?</p>
            </statement>
        </exercise>
    </reading-questions>
    -->
</section>
